# This file is safe to commit. Create a separate .env file with real values.
SECRET_KEY=replace-this-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_ROOT_PASSWORD@localhost:3306/idpms_db
# Generate a new key with: .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=PASTE_A_NEW_FERNET_KEY_HERE
# The account with this email becomes the first administrator after it logs in.
ADMIN_EMAIL=your-admin-account@example.com
